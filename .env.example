# Twilio Account Credentials (required)
ACCOUNT_SID=your_twilio_account_sid_here
AUTH_TOKEN=your_auth_token_here

# Default WhatsApp Numbers
DEFAULT_FROM=whatsapp:+14155238886
DEFAULT_TO=whatsapp:+your_phone_number_here

# Content Template (for POST /send-message)
CONTENT_SID=your_content_template_sid_here
CONTENT_VARIABLES={"1":"12/1","2":"3pm"}

# Google Sheets
SPREADSHEET_ID=your_google_sheet_id_here
# Local only — path to service account JSON file:
GOOGLE_CREDENTIALS_PATH=beaming-opus-452719-u5-b39abc625ad4.json
# Vercel only — base64-encoded service account JSON (run: npm run prepare-vercel):
# GOOGLE_CREDENTIALS_JSON=

# Optional — send audio reply instead of Hebrew text (must be a public HTTPS URL)
# VOICE_MESSAGE_URL=https://example.com/voice.mp3

# Server Port (local only)
PORT=3000
